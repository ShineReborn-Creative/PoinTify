{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Izin untuk jendela notch, pengaturan, dan Pip di desktop",
  "windows": [
    "main",
    "settings",
    "pet"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-set-focus",
    "dialog:default",
    "drag:default",
    "opener:default",
    "updater:default",
    "process:allow-restart"
  ]
}
