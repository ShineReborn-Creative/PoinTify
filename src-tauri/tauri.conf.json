{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PoinTify",
  "version": "0.4.0",
  "identifier": "com.ojan.pointify",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PoinTify",
        "width": 640,
        "height": 460,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Ojan · ShineReborn Creative",
    "copyright": "© 2026 Ojan",
    "category": "Productivity",
    "homepage": "https://github.com/ShineReborn-Creative/PoinTify",
    "shortDescription": "Asisten kecil di atas layar Windows · A little helper at the top of your Windows screen",
    "longDescription": "PoinTify: notch ala Dynamic Island untuk Windows dengan musik dan lirik, widget, timer fokus, pengingat minum, rak file, Pip di desktop, dan chat dengan Claude.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "PoinTify"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzMDBENzU1N0I3QTNFRkQKUldUOVBucDdWZGNBRTd2NS9IelMwZHRZMHRvTTZ4QkdvMnE2aVE1eDZkTmp0NUdvQU5aaWpzK0QK",
      "endpoints": [
        "https://github.com/ShineReborn-Creative/PoinTify/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
