{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PoinTify",
  "version": "0.2.0",
  "identifier": "com.ojan.pointify",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PoinTify",
        "width": 640,
        "height": 460,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "Asisten kecil di atas layar Windows",
    "longDescription": "PoinTify: notch ala Dynamic Island untuk Windows dengan musik dan lirik, timer fokus, pengingat minum, rak file, dan chat dengan Claude.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
